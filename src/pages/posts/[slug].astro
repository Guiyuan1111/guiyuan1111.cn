---
import type { CollectionEntry } from 'astro:content'
import { getCollection, render } from 'astro:content'
// [评论系统永久停用] 评论组件已移出构建，见 备份/comment-backup/ 与 note/disabled-features.md 第 3 节
// import Comment from '@/components/Comment/Index.astro'
import PostDate from '@/components/PostDate.astro'
import TagList from '@/components/TagList.astro'
import BackButton from '@/components/Widgets/BackButton.astro'
import TOC from '@/components/Widgets/TOC.astro'
import Layout from '@/layouts/Layout.astro'
import { checkPostSlugDuplication } from '@/utils/content'
import { getPostDescription } from '@/utils/description'
// [CSS 按页分割] 正文排版与扩展容器样式仅文章页需要（原在 Layout.astro 全局加载）
// [评论系统永久停用] comment.css（208 行，Twikoo/Waline/Giscus 定制样式）已移至 备份/comment-backup/
// import '@/styles/comment.css'
import '@/styles/extension.css'
import '@/styles/markdown.css'

export async function getStaticPaths() {
  const posts: CollectionEntry<'posts'>[] = await getCollection('posts')

  // Check if there are duplicate post slugs
  const duplicates = await checkPostSlugDuplication(posts)
  if (duplicates.length > 0) {
    throw new Error(`Duplicate post slugs:\n${duplicates.join('\n')}`)
  }

  // [多语言已永久停用] 本文件原为 [...lang]/posts/[slug].astro，语言版 getStaticPaths、lang 参数、
  // slugToLangsMap 与 supportedLangs 传递链已在 v1.0.6–v1.0.9 全部移除；
  // 内容 schema 的 lang 只允许 ''/'zh'，无需再按语言筛选。
  // 历史代码备份在 备份/i18n-backup/，见 note/disabled-features.md

  return posts
    // Show drafts in dev mode only
    .filter(post => import.meta.env.DEV || !post.data.draft)
    .map(post => ({
      params: { slug: post.data.abbrlink || post.id },
      props: { post },
    }))
}

interface Props {
  post: CollectionEntry<'posts'>
}

const { post } = Astro.props
const slug = post.data.abbrlink || post.id
const description = getPostDescription(post, 'meta')
const { Content, headings, remarkPluginFrontmatter } = await render(post)
---

<Layout
  postTitle={post.data.title}
  postDescription={description}
  postSlug={post.id}
  postMath={post.data.math}
>
  <article class="heti">
    <div class="relative">
      <!-- Go Back Button On Desktop -->
      <BackButton />
      <!-- Title -->
      <h1 class="post-title">
        <span
          transition:name={`post-${slug}`}
          data-disable-theme-toggle-transition
        >
          {post.data.title}
        </span>
      </h1>
    </div>

    <!-- Date -->
    <div
      id="post-date"
      class="mb-17.2 block c-primary font-time"
      transition:name={`time-${slug}`}
      data-disable-theme-toggle-transition
    >
      <PostDate
        date={post.data.published}
        updatedDate={post.data.updated}
        minutes={remarkPluginFrontmatter.minutes}
      />
    </div>
    <!-- TOC -->
    {post.data.toc && <TOC headings={headings} />}
    <!-- Content -->
    <div id="post-content">
      <Content />
      <!-- Copyright -->
      <div id="post-copyright" />
      <!-- Tag List -->
      {post.data.tags?.length > 0 && (
        <div class="mt-12.6 uno-decorative-line" />
        <TagList tags={post.data.tags} />
      )}
      <!-- [评论系统永久停用] 评论区渲染已注释，本站不再提供评论功能
      <Comment />
      -->
    </div>
  </article>
</Layout>
