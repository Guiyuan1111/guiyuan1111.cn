---
import { getCollection, render } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
// [CSS 按页分割] 关于页正文走与文章页相同的 markdown 插件管线（.heti 排版、admonition/fold/github-card 等扩展容器均可能出现）
import '@/styles/extension.css'
import '@/styles/markdown.css'

const aboutEntries = await getCollection('about')
const aboutEntry = aboutEntries[0]
const { Content } = aboutEntry ? await render(aboutEntry) : { Content: null }
---

<Layout>
  <!-- Decorative Line -->
  <div class="uno-decorative-line" />
  <!-- About Page Content -->
  <div class="heti">
    {Content && <Content />}
  </div>
</Layout>
