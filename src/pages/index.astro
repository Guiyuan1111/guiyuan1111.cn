---
import PostList from '@/components/PostList.astro'
import Layout from '@/layouts/Layout.astro'
import { getPinnedPosts, getPostsByYear } from '@/utils/content'
// [CSS 按页分割] 首页文章摘要列表使用 .heti 排版（PostList.astro 中的描述块）
import '@/styles/markdown.css'

const pinnedPosts = await getPinnedPosts()
const postsByYear = await getPostsByYear()
---

<Layout>
  <!-- Pinned Posts -->
  {pinnedPosts.length > 0 && (
    <section class="mb-7.5">
      <div class="uno-decorative-line" />
      <PostList posts={pinnedPosts} pinned={true} />
    </section>
  )}

  <!-- Regular Posts -->
  {Array.from(postsByYear.entries(), ([_year, posts]) => (
    <section class="mb-7.5">
      <div class="uno-decorative-line" />
      <PostList posts={posts} />
    </section>
  ))}
</Layout>
